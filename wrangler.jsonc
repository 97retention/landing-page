{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "97retention",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "97retention.com", "custom_domain": true },
    { "pattern": "www.97retention.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
